# ==============================================================================
# PixivToolkit - Git Ignore Rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging / PyInstaller
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# PyInstaller logs & caches
build.log

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage / linting
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments / Virtual Envs
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Nginx runtime data & logs
nginx/logs/*
!nginx/logs/.gitkeep
nginx/temp/*
!nginx/temp/.gitkeep
nginx/cache/*
!nginx/cache/.gitkeep
nginx/ca/*
!nginx/ca/.gitkeep
nginx/conf/ca/*
!nginx/conf/ca/.gitkeep
nginx/ca.cer
ca.cer
*.pid

# SSL Certificates & Private Keys (Auto-generated locally, NEVER commit)
*.key
*.cer
*.crt
*.pem
*.pfx
*.p12

# Project runtime local configuration & cache
config.json
config.json.bak
probe_results.json

# Temporary & backup files
*.bak
*.tmp
*.log
hosts.ptk_bak_*
*_backup.py

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.BIN/

# ==============================================================================
# 本地测试产物 (不上传: 网络探测脚本与不可用项存档)
# ==============================================================================
# 候选对象连通性探测脚本与结果 (仅本地排查用)
scripts/probe_candidates.py
scripts/probe_candidates_retest.py
scripts/probe_candidates_results.json
# 已测试不可用对象存档报告
TEST_REPORT_UNUSABLE.md
# 测速超时诊断脚本 (本地排查用)
scripts/diag_timeout.py

# ==============================================================================
# 本地运行产物 / 文档 / 结果数据 (不上传)
# ==============================================================================
# QUIC 直连启动器创建的浏览器专用配置目录 (体积可达数十 MB, 纯缓存)
browser_profiles/
# 本地备份 (hosts / nginx 配置 / upstream 快照)
backups/
# 文档目录: 本地留存, 不上传
docs/
# 探测/审计的结果数据 (脚本可上传, 结果属本机实测数据)
scripts/*_results.json
scripts/_probe_*
tools/audit_result.txt
# 测试与调试留下的临时文件
temp_fast_hosts
nginx/conf/*.bak_*
*.orig

# ==============================================================================
# 测试套件与本地探测脚本 (仅本地回归/实测使用, 不上传)
# ==============================================================================
# 测试套件: 保留在本地用于回归, 不随仓库上传
tests/
# 本地探测 / 审计 / 验证脚本 (历次实测的复现工具)
scripts/probe_*.py
scripts/audit_*.py
scripts/test_*.py
scripts/benchmark_*.py
# 一次性排障 / 紧急清理助手 (与 probe_* 同类: 只在本机排查时用, 不上传)
scripts/fix_ca_trust.py
scripts/clean_residual_root.py
scripts/nrpt_emergency_clean.py
scripts/nrpt_step.py
scripts/hosts_step.py
scripts/connect_forwarder.py
scripts/clean_extra_root.py
# tools 下的开发脚本 (运行时必需的 tools/ech_tunnel/ 不受影响: 只匹配 tools/*.py)
tools/*.py
scripts/*.json
