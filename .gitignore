# ==============================================================================
# PixivToolkit - Git Ignore Rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging / PyInstaller
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# PyInstaller logs & caches
build.log

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage / linting
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments / Virtual Envs
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Nginx runtime data & logs
nginx/logs/*
!nginx/logs/.gitkeep
nginx/temp/*
!nginx/temp/.gitkeep
nginx/cache/*
!nginx/cache/.gitkeep
nginx/ca/*
!nginx/ca/.gitkeep
nginx/conf/ca/*
!nginx/conf/ca/.gitkeep
nginx/ca.cer
ca.cer
*.pid

# SSL Certificates & Private Keys (Auto-generated locally, NEVER commit)
*.key
*.cer
*.crt
*.pem
*.pfx
*.p12

# Project runtime local configuration & cache
config.json
config.json.bak
probe_results.json

# Temporary & backup files
*.bak
*.tmp
*.log
hosts.ptk_bak_*
*_backup.py

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.BIN/

# ==============================================================================
# 本地测试产物 (不上传: 网络探测脚本与不可用项存档)
# ==============================================================================
# 候选对象连通性探测脚本与结果 (仅本地排查用)
scripts/probe_candidates.py
scripts/probe_candidates_retest.py
scripts/probe_candidates_results.json
# 已测试不可用对象存档报告
TEST_REPORT_UNUSABLE.md
# 测速超时诊断脚本 (本地排查用)
scripts/diag_timeout.py

# ==============================================================================
# 本地运行产物 / 文档 / 结果数据 (不上传)
# ==============================================================================
# QUIC 直连启动器创建的浏览器专用配置目录 (体积可达数十 MB, 纯缓存)
browser_profiles/
# 本地备份 (hosts / nginx 配置 / upstream 快照)
backups/
# 文档目录: 本地留存, 不上传
docs/
# 探测/审计的结果数据 (脚本可上传, 结果属本机实测数据)
scripts/*_results.json
scripts/_probe_*
# 根目录的候选节点探测报告 (本机实测数据: 逐服务候选 IP / 延迟 / 可用性)
ipv4_report.json
ipv6_report.json
# 探测脚本落盘的一次性产物: 抓取的页面/响应头转储/图片与模型分片
scripts/*.html
scripts/*.txt
scripts/*.bin
tools/audit_result.txt
# 测试与调试留下的临时文件
temp_fast_hosts
nginx/conf/*.bak_*
*.orig

# ==============================================================================
# 测试套件与本地探测脚本 (仅本地回归/实测使用, 不上传)
# ==============================================================================
# 测试套件: 保留在本地用于回归, 不随仓库上传
tests/
# 本地探测 / 审计 / 验证脚本 (历次实测的复现工具)
scripts/probe_*.py
# ★ 例外 (2026-10-04): 下面两个探测脚本**入库**。
#   理由: 它们不是"一次性排障", 而是多条已归档结论的**判据载体** —— 文档写在被忽略的
#   docs/ 里、测试写在被忽略的 tests/ 里, 若复现工具也不入库, 那么
#   docs/googlevideo-node-availability.md §7 的每条结论对新克隆都**无法复现**。
#   具体承载:
#     · probe_gvs_nodes.py     — 同刻交错 A/B 的通用轴 (--ab-var addr_health|retries)
#                                与腿参数注入 (--leg-first-byte/--leg-retries) ⇒ §7.7
#     · probe_gvs_alt_paths.py — 替代通路 (端口 / 传输) 的判据 ⇒ §7.6.5
!scripts/probe_gvs_nodes.py
!scripts/probe_gvs_alt_paths.py
scripts/audit_*.py
scripts/test_*.py
scripts/benchmark_*.py
# 一次性排障 / 紧急清理助手 (与 probe_* 同类: 只在本机排查时用, 不上传)
scripts/fix_ca_trust.py
scripts/clean_residual_root.py
scripts/nrpt_emergency_clean.py
scripts/nrpt_step.py
scripts/hosts_step.py
scripts/connect_forwarder.py
scripts/clean_extra_root.py
# tools 下的开发脚本 (运行时必需的 tools/ech_tunnel/ 不受影响: 只匹配 tools/*.py)
tools/*.py
scripts/*.json
# PAC 探测的运行时产物 (probe_pac_playback.py 的 WORK 目录: 生成的 proxy.pac)
scripts/_pac_work/
# Go 黑盒测试台 (仅测试用, 与 tests/ 同口径: 本地留存, 不上传)
tools/h3_legtest/
# 候选池探测三件套 (无运行时引用: 工具 + 生成的候选池描述 + 重生成/校验脚本)
app/probe_pool.py
app/pools.json
scripts/regen_pools.py
# 分组站点配置: **生成物**, 不入库 —— NginxManager.test_config() 会在 `nginx -t`
# 之前按 service_profile.SITE_FILE_FOR_GROUP 重新渲染, 并只在预检通过后才原子
# 提交回 conf/ (2026-10-04 实测: 四个文件全删后调用 test_config() 仍返回 True,
# 并报 "已更新: site-acg/adult/dev/gaming.conf")。故全新 clone 首次启动会自愈,
# nginx.conf 里那四条显式 include 不会因此失效。
nginx/conf/site-*.conf

# ── 编译产物 (2026-10-03) ──────────────────────────────────────────────
# ECH 隧道的源码在 tools/ech_tunnel/ (echconfig.go / main.go / resolver.go),
# 由 build.ps1 编译。二进制不入库 —— 但**源码必须留**。
tools/ech_tunnel/ech-tunnel.exe
tools/ech_tunnel/ech-tunnel.exe~
tools/**/*.exe
tools/**/*.exe~
