scripts/*.html
scripts/*.txt
scripts/*.bin
tools/audit_result.txt
# 测试与调试留下的临时文件
temp_fast_hosts
nginx/conf/*.bak_*
*.orig

# ==============================================================================
# 测试套件与本地探测脚本 (仅本地回归/实测使用, 不上传)
# ==============================================================================
# 测试套件: 保留在本地用于回归, 不随仓库上传
tests/
# 本地探测 / 审计 / 验证脚本 (历次实测的复现工具)
scripts/probe_*.py
# ★ 2026-10-05 变更 (用户要求): 上面这些探测/诊断脚本**不再入库**, 连同原有的
#   `!` 例外一并删除 —— 例外当初的理由是"承载已归档结论的判据", 但那些结论写在
#   被忽略的 docs/ 与 tests/ 里, 复现工具留在本机即可; 入库只让每次实测都变成提交噪音。
scripts/probe_*.py
scripts/diag_*.py
scripts/audit_*.py
scripts/measure_*.py
scripts/browser_*.py
scripts/ab_*.py
# verify_* 仍入库: 它们承载"报不可用而实际可用"的端到端验收, 不是一次性排查。
scripts/verify_*.py
!scripts/verify_image_fetch_via_proxy.py
!scripts/verify_gallery_images_via_proxy.py
!scripts/verify_xbox_github_paths.py
!scripts/verify_cert_gate.py
!scripts/verify_nginx_stub_status.py
!scripts/verify_site_candidate.py
!scripts/verify_civitai_images_h3.py
scripts/test_*.py
scripts/benchmark_*.py
# 一次性排障 / 紧急清理助手 (与 probe_* 同类: 只在本机排查时用, 不上传)
scripts/fix_ca_trust.py
scripts/clean_residual_root.py
scripts/nrpt_emergency_clean.py
scripts/nrpt_step.py
scripts/hosts_step.py
scripts/connect_forwarder.py
scripts/clean_extra_root.py
# tools 下的开发脚本 (运行时必需的 tools/ech_tunnel/ 不受影响: 只匹配 tools/*.py)
tools/*.py
scripts/*.json
# PAC 探测的运行时产物 (probe_pac_playback.py 的 WORK 目录: 生成的 proxy.pac)
scripts/_pac_work/
# Go 黑盒测试台 (仅测试用, 与 tests/ 同口径: 本地留存, 不上传)
tools/h3_legtest/
# 候选池探测三件套 (无运行时引用: 工具 + 生成的候选池描述 + 重生成/校验脚本)
app/probe_pool.py
app/pools.json
scripts/regen_pools.py
# 分组站点配置: **生成物**, 不入库 —— NginxManager.test_config() 会在 `nginx -t`
# 之前按 service_profile.SITE_FILE_FOR_GROUP 重新渲染, 并只在预检通过后才原子
# 提交回 conf/ (2026-10-04 实测: 四个文件全删后调用 test_config() 仍返回 True,
# 并报 "已更新: site-acg/adult/dev/gaming.conf")。故全新 clone 首次启动会自愈,
# nginx.conf 里那四条显式 include 不会因此失效。
nginx/conf/site-*.conf

# 动态 upstream 优选配置: **同样是生成物**, 不入库 (2026-10-04 补)
#
# 为什么它该和 site-*.conf 同待遇 (用户提出, 并已实测确认):
#   · **同一个生成器家族的产物** —— 由双通道测速引擎按本机实测结果写出; 上面的 site-*.conf
#     已因"生成物不入库"被忽略, 单独留它入库是判据不一致。
#   · **内容是机器/时间专属的**: 文件头写着"生成时间", 正文是本机测出来的 Akamai/Cloudflare
#     候选 IP 与优先级 (实测一次重生成里 28 行改动**全部**是时间戳 + IP 换序, 无逻辑变化)。
#     入库等于把某台机器的网络测量结果当成项目真理, 对别人无意义。
#   · **会无休止地 dirty, 且掩盖真实改动**: `git log` 显示它已被改过 **37 次**, 其中多次是
#     纯 `chore: 更新/重新生成动态 upstream 优选配置`。每轮 `git status` 都带噪音, 而噪音的
#     代价是"分不清哪些是真实代码改动" —— 本项目已多次为此付账。
#   · **自愈已验证**: 删掉它再调 NginxManager.test_config(), 返回 True 并重新写出该文件
#     (与 site-*.conf 的"全删后仍 True"同款证据), 故全新 clone 首次启动不会因缺它而失败。
#
# ⚠ 只对 git 生效: 文件仍在磁盘上, nginx.conf 的 include 照常工作。取消跟踪用的是
#   `git rm --cached` (不是 `git rm`) —— 后者会删掉磁盘文件并让 include 失败。
nginx/conf/upstream-dynamic.conf

# ── 编译产物 (2026-10-03) ──────────────────────────────────────────────
# ECH 隧道的源码在 tools/ech_tunnel/ (echconfig.go / main.go / resolver.go),
# 由 build.ps1 编译。二进制不入库 —— 但**源码必须留**。
tools/ech_tunnel/ech-tunnel.exe
tools/ech_tunnel/ech-tunnel.exe~
tools/**/*.exe
tools/**/*.exe~
